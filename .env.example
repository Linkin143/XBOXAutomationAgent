# ============================================================
# Automation V4 Agent — Environment Variables Template
# Copy this file to .env and fill in your API keys.
# NEVER commit .env to version control!
# ============================================================

# ── LLM Provider API Keys (set at least one) ─────────────────
# OpenAI — required for GPT-4o
OPENAI_API_KEY=sk-...your-openai-key-here...

# Anthropic — required for Claude 3.5 Sonnet
ANTHROPIC_API_KEY=sk-ant-...your-anthropic-key-here...

# ── LiteLLM Model Override (optional) ────────────────────────
# Override the primary model at runtime without changing llm_config.yaml
# Options: "gpt-4o" | "gpt-4-turbo" | "gpt-4o-mini" | "claude-3-5-sonnet-20241022"
LITELLM_MODEL=gpt-4o

# Override fallback model
LITELLM_FALLBACK_MODEL=claude-3-5-sonnet-20241022

# Override temperature (0.0 = fully deterministic, 1.0 = creative)
LITELLM_TEMPERATURE=0.1

# ── Hardware Port Overrides (optional) ───────────────────────
# Override serial ports without editing hardware_config.yaml
GIMX_HOST=127.0.0.1
GIMX_PORT_C1=51914
GIMX_PORT_C2=51915
RELAY_PORT=COM8
ARDUINO_KBM_PORT=COM3
CAMERA_DEVICE_INDEX=0

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=DEBUG
LOG_DIR=logs
